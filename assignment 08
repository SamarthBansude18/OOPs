
#include <iostream>
#include <string>
using namespace std;

class BankAccount {
private:
    string accountHolder;
    double balance;

public:
    BankAccount(string name, double initialBalance) {
        if (initialBalance < 0) {
            throw "Initial balance cannot be negative";
        }

        if (name.empty()) {
            throw "Account holder name cannot be empty";
        }

        accountHolder = name;
        balance = initialBalance;
    }

    void deposit(double amount) {
        if (amount <= 0) {
            throw "Deposit amount must be positive.";
        }

        balance += amount;
        cout << "Deposit successful!" << endl;
        cout << "Available Balance: Rs. " << balance << endl;
    }

    void withdraw(double amount) {
        if (amount <= 0) {
            throw "Withdrawal amount must be positive.";
        }

        if (amount > balance) {
            throw "Insufficient account balance.";
        }

        balance -= amount;
        cout << "Withdrawal successful!" << endl;
        cout << "Available Balance: Rs. " << balance << endl;
    }

    void checkBalance() {
        cout << "Account Holder: " << accountHolder << endl;
        cout << "Available Balance: Rs. " << balance << endl;
    }
};

int main() {
    string name;
    double initialBalance;

    cout << "Enter Account Holder Name: ";
    getline(cin, name);

    cout << "Enter Initial Balance: ";

    try {
        if (!(cin >> initialBalance)) {
            throw "Invalid input for initial balance.";
        }

        BankAccount account(name, initialBalance);

        int choice;

        do {
            cout << "\n===== BANK ACCOUNT MENU =====" << endl;
            cout << "1. Deposit Money" << endl;
            cout << "2. Withdraw Money" << endl;
            cout << "3. Check Balance" << endl;
            cout << "4. Exit" << endl;
            cout << "Enter your choice: ";

            if (!(cin >> choice)) {
                throw "Invalid menu input.";
            }

            try {
                switch (choice) {
                    case 1: {
                        double amount;

                        cout << "Enter deposit amount: ";
                        if (!(cin >> amount)) {
                            throw "Invalid deposit input.";
                        }

                        account.deposit(amount);
                        break;
                    }

                    case 2: {
                        double amount;

                        cout << "Enter withdrawal amount: ";
                        if (!(cin >> amount)) {
                            throw "Invalid withdrawal input.";
                        }

                        account.withdraw(amount);
                        break;
                    }

                    case 3:
                        account.checkBalance();
                        break;

                    case 4:
                        cout << "Thank you for using our bank!"
                             << endl;
                        break;

                    default:
                        cout << "Invalid choice! Try again."
                             << endl;
                }
            }
            catch (const char* error) {
                cout << "Transaction failed: "
                     << error << endl;
            }

        } while (choice != 4);
    }
    catch (const char* error) {
        cout << "Account creation failed: "
             << error << endl;
    }

    return 0;
}
